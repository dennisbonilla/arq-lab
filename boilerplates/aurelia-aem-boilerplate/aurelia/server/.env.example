# ---- Server ----
PORT=4000
# Allowed origins for CORS (comma-separated). In dev, Vite's:
CORS_ORIGIN=http://localhost:5173

# ---- Supabase (external contacts CRM) ----
# Use the SERVICE ROLE key ONLY on the server. Never on the client.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Resend (transactional email) ----
RESEND_API_KEY=re_...
# Must be a verified domain in Resend:
RESEND_FROM=Aurelia <hola@tudominio.com>
# Where the internal notification of new leads arrives:
CONTACT_TEAM_EMAIL=equipo@tudominio.com
